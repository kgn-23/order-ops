// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRoleType {
  ADMIN
  MANAGER
  CALLER
}


enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum OrderShipmentStage {
  BOOKED
  RECEIVED
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_ATTEMPTED
  AVAILABLE_FOR_COLLECTION
  RTO
  OTHER
}

enum CallOutcomeType {
  CALLED
  NO_ANSWER
  BUSY
  FAILED
  INVALID_NUMBER
  OTHER
}

enum AssignmentType {
  MANUAL
  ROUND_ROBIN
  RULE_BASED
}

enum CommerceStatusChangeSource {
  UPLOAD
  CALL_LOG
  ADMIN
  BACKFILL
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  phone        String?
  isActive     Boolean           @default(true)
  callerTeamId String?
  roles        UserRole[]
  callLogs     CallLog[]
  assignments  OrderAssignment[] @relation("AssigneeAssignments")
  assignedBy   OrderAssignment[] @relation("AssignedByAssignments")
  activityLogs ActivityLog[]
  callerTeam   CallerTeam?       @relation("CallerTeamMembers", fields: [callerTeamId], references: [id], onDelete: SetNull)
  ledTeam      CallerTeam?       @relation("CallerTeamLeader")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  followUps    FollowUp[]
  codExportBatches CodExportBatch[] @relation("CodExportBatches")
  commerceStatusChanges OrderCommerceStatusEvent[] @relation("CommerceStatusChanges")

  @@index([callerTeamId])
}

model CallerTeam {
  id        String   @id @default(cuid())
  name      String
  leaderId  String   @unique
  leader    User     @relation("CallerTeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  callers   User[]   @relation("CallerTeamMembers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([name])
}

model Role {
  id        String       @id @default(cuid())
  code      UserRoleType @unique
  label     String
  users     UserRole[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, roleId])
  @@index([roleId])
}

model Customer {
  id             String    @id @default(cuid())
  fullName       String
  primaryPhone   String
  secondaryPhone String?
  email          String?
  normalizedKey  String    @unique
  orders         Order[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([primaryPhone])
}

model Order {
  id               String                    @id @default(cuid())
  externalOrderId  String?
  sourceSystem     String                    @default("MANUAL")
  sourceOrderId    String?
  webhookEventId   String?
  customerId       String
  trackingNumber   String?
  currentStage     OrderShipmentStage                @default(BOOKED)
  previousStage    OrderShipmentStage?
  orderStatus      OrderStatus?             @default(PENDING)
  customerName     String
  customerPhone    String
  addressLine1     String
  addressLine2     String?
  addressLine3     String?
  city             String
  state            String
  postalCode       String
  country          String                    @default("IN")
  /// Full refined shipping address captured by caller during a call (optional).
  refinedAddress   String?                   @db.Text
  bookingProvider  String?
  bookingRef       String?
  bookedAt         DateTime?
  labelUrl         String?
  labelGeneratedAt DateTime?
  /// Optional commerce snapshot (nullable when unknown or not from a storefront export)
  merchantOrderDisplayName String?
  merchantOrderCreatedAt   DateTime?
  financialStatus          String?
  fulfillmentStatus        String?
  currencyCode             String?           @db.VarChar(12)
  subtotalAmount           Decimal?          @db.Decimal(14, 2)
  shippingAmount           Decimal?          @db.Decimal(14, 2)
  taxesAmount              Decimal?          @db.Decimal(14, 2)
  totalAmount              Decimal?          @db.Decimal(14, 2)
  discountAmount           Decimal?          @db.Decimal(14, 2)
  paymentMethod            String?
  paymentReference         String?
  shippingMethodLabel      String?
  merchantOrderNotes       String?           @db.Text
  orderTags                String?
  primaryVendor            String?
  orderChannel             String?
  riskLevel                String?
  statusEvents     OrderStatusEvent[]
  commerceStatusEvents OrderCommerceStatusEvent[]
  assignments      OrderAssignment[]
  callLogs         CallLog[]
  followUps        FollowUp[]
  addressChecks    AddressValidationResult[]
  activityLogs     ActivityLog[]
  lineItems        OrderLineItem[]
  customer         Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  codExportBatchId String?
  codExportBatch   CodExportBatch?           @relation(fields: [codExportBatchId], references: [id], onDelete: SetNull)
  exportedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?

  @@index([customerId, createdAt])
  @@index([currentStage, createdAt])
  @@index([trackingNumber])
  @@index([customerPhone])
  @@index([deletedAt, createdAt])
  @@index([deletedAt, currentStage, createdAt])
  @@index([sourceSystem, sourceOrderId])
  @@index([deletedAt, sourceSystem, orderStatus, exportedAt])
}

model CodExportBatch {
  id          String    @id @default(cuid())
  createdById String
  createdBy   User      @relation("CodExportBatches", fields: [createdById], references: [id], onDelete: Restrict)
  format      String    @default("COD_FILE_4")
  orderCount  Int
  fileName    String
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([createdById, createdAt])
  @@index([createdAt])
}

model OrderLineItem {
  id                    String    @id @default(cuid())
  orderId               String
  quantity              Int?
  title                 String?
  sku                   String?
  unitPrice             Decimal?  @db.Decimal(14, 2)
  compareAtPrice        Decimal?  @db.Decimal(14, 2)
  requiresShipping      Boolean?
  taxable               Boolean?
  lineFulfillmentStatus String?
  vendor                String?
  lineDiscountAmount    Decimal?  @db.Decimal(14, 2)
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  @@index([orderId, deletedAt])
}

model OrderStatusEvent {
  id             String     @id @default(cuid())
  orderId        String
  stage          OrderShipmentStage
  provider       String
  externalStatus String
  notes          String?
  rawPayload     Json?
  idempotencyKey String?
  eventAt        DateTime   @default(now())
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@unique([provider, idempotencyKey])
  @@index([orderId, eventAt])
}

model OrderCommerceStatusEvent {
  id          String                     @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  source      CommerceStatusChangeSource
  callLogId   String?
  notes       String?
  order       Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy   User?                      @relation("CommerceStatusChanges", fields: [changedById], references: [id], onDelete: SetNull)
  callLog     CallLog?                   @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  deletedAt   DateTime?

  @@index([orderId, createdAt])
  @@index([changedById, createdAt])
  @@index([toStatus, createdAt])
}

model OrderAssignment {
  id               String         @id @default(cuid())
  orderId          String
  assigneeId       String
  assignedByUserId String
  assignmentType   AssignmentType @default(MANUAL)
  reason           String?
  isActive         Boolean        @default(true)
  assignedAt       DateTime       @default(now())
  unassignedAt     DateTime?
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignee         User           @relation("AssigneeAssignments", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy       User           @relation("AssignedByAssignments", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  @@index([orderId, isActive])
  @@index([assigneeId, isActive])
}

model CallLog {
  id            String          @id @default(cuid())
  orderId       String
  callerId      String
  orderStage    OrderShipmentStage?
  outcome       CallOutcomeType
  notes         String?
  callDurationS Int?
  recordingUrl  String?
  calledAt      DateTime        @default(now())
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  caller        User            @relation(fields: [callerId], references: [id], onDelete: Restrict)
  commerceStatusEvents OrderCommerceStatusEvent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([orderId, calledAt])
  @@index([callerId, calledAt])
  @@index([orderStage, calledAt])
  @@index([deletedAt, calledAt])
}

model FollowUp {
  id          String    @id @default(cuid())
  orderId     String
  createdById String
  dueAt       DateTime?
  notes       String
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([orderId, isClosed])
}

model AddressValidationResult {
  id               String    @id @default(cuid())
  orderId          String
  validatedBy      String    @default("LLM")
  originalAddress  String
  suggestedAddress String?
  confidence       Float?
  remarks          String?
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model ActivityLog {
  id          String    @id @default(cuid())
  actorUserId String?
  orderId     String?
  entityType  String
  entityId    String
  action      String
  details     Json?
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
}

model WebhookInboxEvent {
  id          String   @id @default(cuid())
  endpoint    String
  method      String
  headers     Json?
  payload     Json?
  rawBody     String?
  receivedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([endpoint, receivedAt])
}
